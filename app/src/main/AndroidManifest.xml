<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE (neverForLocation: we don't derive location from BLE scans) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Location: used for GPS trip recording on all versions, and by BLE scan on API < 31.
         tools:remove strips maxSdkVersion="30" that some merged library manifests inject, which
         would otherwise leave FINE undeclared on Android 12+ and downgrade trip GPS to coarse. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:remove="android:maxSdkVersion" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Lets the battery-optimisation warning open the one-tap exemption dialog
         instead of dropping the rider into a system list to hunt for the app.
         Only ever used to ask; the optimiser kills the wheel service mid-ride
         otherwise, which reads as a trip that stopped recording by itself. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Overlay Studio camera viewports + optional mic audio in recordings.
         The studio renders and encodes its own video frames, so it needs no
         screen-capture / projection permission. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Notifications (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phone HUD: draws an Overlay Studio preset on top of other apps.
         Special access, granted by the rider in system settings, never silently. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Internet (WebView for trip viewer; also the HUD companion server) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- HUD companion server: JmDNS joins the 224.0.0.251 multicast group to
         advertise _eucplanet._tcp on the phone hotspot subnet. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- BLE feature requirement -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Camera + mic are optional: the Overlay Studio degrades to solid-colour
         viewports (and no recorded audio) on devices that lack them, so the
         app stays installable. The CAMERA and RECORD_AUDIO permissions
         otherwise imply android.hardware.camera, .camera.autofocus and
         .microphone as REQUIRED, which silently excludes ~3% of phones. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".EucPlanetApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.EucPlanet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.EucPlanet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share-to-app: Google Maps / any app sharing a place sends a
                 SEND with a plain-text payload. We parse it for lat/lng or
                 fall back to using it as a geocoder query. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Android-standard "geo:" URI for opening a place in a map. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <!-- Live location share link (also served as a web page for riders
                 without the app). autoVerify needs /.well-known/assetlinks.json
                 on eucplanet.ried.no. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="eucplanet.ried.no" android:path="/share" />
            </intent-filter>
            <!-- Dropbox OAuth (PKCE) redirect. App-key-prefixed scheme is
                 the Dropbox-recommended way to bounce the consent page back
                 into the app. See DropboxRepository.REDIRECT_URI. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="db-5auhxf7gswy7j54" />
            </intent-filter>
        </activity>

        <!-- Notification access, granted by the rider, purely so
             MediaSessionManager.getActiveSessions() will answer: it is the
             only route to another app's playback rate. Nothing is read from
             notifications; see MediaAccessService. -->
        <service
            android:name=".service.MediaAccessService"
            android:exported="false"
            android:label="@string/media_rate_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.WheelService"
            android:foregroundServiceType="connectedDevice|location"
            android:exported="false" />

        <!-- Wear OS Data Layer: receives /euc/control messages from a paired watch. -->
        <service
            android:name=".wear.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/euc/" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home screen widget. Not exported: only the system needs to reach it. -->
        <!--
          Weather on the home screen: one cell for the answer, and the
          forecast at whatever size it is dragged to. Both paint the same
          snapshot. Not exported: the only broadcast they answer is our own
          refresh action, sent from the widgets themselves.
        -->
        <receiver android:name=".widget.WeatherScoreWidget"
            android:label="@string/widget_weather_score_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_score_info" />
        </receiver>
        <receiver android:name=".widget.WeatherCompactWidget"
            android:label="@string/widget_weather_compact_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.eried.eucplanet.widget.WEATHER_REFRESH" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.EucWidget"
            android:label="@string/widget_euc_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_euc_info" />
        </receiver>

        <!--
          Button-only variants, all sharing the full widget's configured
          actions. Separate providers because Android cannot tell one instance
          of a widget from another without a configuration activity, and the
          rider should be able to drop "the horn button" on a home screen
          without answering a dialog first.
        -->
        <receiver android:name=".widget.EucButtonWidget"
            android:label="@string/widget_act_1_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_act_1_info" />
        </receiver>
        <receiver android:name=".widget.EucButton2Widget"
            android:label="@string/widget_act_2_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_act_2_info" />
        </receiver>
        <receiver android:name=".widget.EucButton3Widget"
            android:label="@string/widget_act_3_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_act_3_info" />
        </receiver>
        <receiver android:name=".widget.EucButtons12Widget"
            android:label="@string/widget_act_12_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_act_12_info" />
        </receiver>
        <receiver android:name=".widget.EucButtons23Widget"
            android:label="@string/widget_act_23_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_act_23_info" />
        </receiver>

        <!-- Let the Application class provide the WorkManager Configuration (Hilt worker factory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
