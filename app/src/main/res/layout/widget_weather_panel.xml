<?xml version="1.0" encoding="utf-8"?>
<!--
  The expanded panel, roughly 4x3: everything the compact one shows, plus the
  hour labels under the curve and the readings for right now.

  It is the same render path and the same snapshot as the other two, only with
  more room, so a rider running all three never sees them disagree.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ww_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ww_face"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😄"
            android:textSize="26sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/ww_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="+4"
            android:textSize="26sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#5AB55A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ww_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/weather_face_clear"
                android:textSize="12sp"
                android:textColor="#E8EAED" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ww_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#9AA0A6" />

                <TextView
                    android:id="@+id/ww_wind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textSize="11sp"
                    android:textColor="#9AA0A6" />

                <TextView
                    android:id="@+id/ww_window"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:textColor="#9AA0A6" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/ww_graph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_weather_graph_desc" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ww_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="#9AA0A6" />

        <TextView
            android:id="@+id/ww_stamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textSize="11sp"
            android:textColor="#9AA0A6" />

        <ImageView
            android:id="@+id/ww_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="5dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@string/widget_weather_refresh_desc" />
    </LinearLayout>
</LinearLayout>
