<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-cell version of widget_euc_actions, for the 1x1 providers.

  A separate file rather than hiding the second cell at render time: the widget
  picker inflates previewLayout as static XML and never runs the render path, so
  a shared two-cell layout showed the 1x1 variants with two cramped buttons.
  Same ids as the two-cell layout, so the render code is identical.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_act_cell_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_act_icon_1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/ic_widget_horn"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_act_text_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_horn" />
</LinearLayout>
