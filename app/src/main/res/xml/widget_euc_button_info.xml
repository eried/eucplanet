<?xml version="1.0" encoding="utf-8"?>
<!--
  One cell by one: this widget is a single tap target, so it should be able to
  sit in a dock or a corner without stealing a row. updatePeriodMillis 0 for the
  same reason as the full widget: the launcher's own schedule has a 30 minute
  floor and wakes the device, and WheelService pushes instead.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="60dp"
    android:minHeight="60dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_euc_button"
    android:previewLayout="@layout/widget_euc_button"
    android:description="@string/widget_button_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
