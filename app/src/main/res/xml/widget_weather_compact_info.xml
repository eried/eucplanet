<?xml version="1.0" encoding="utf-8"?>
<!--
  Resizable in both directions: the curve is repainted from the widget's actual
  cells in onAppWidgetOptionsChanged, so stretching it gives more graph rather
  than a scaled-up bitmap.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_weather_compact"
    android:previewLayout="@layout/widget_weather_compact"
    android:description="@string/widget_weather_compact_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
