<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget background. A widget lives on the launcher, outside the app's Compose
  theme, so it cannot read MaterialTheme.appColors and has to carry its own
  colours. Kept deliberately neutral so it sits on any wallpaper.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6121722" />
    <corners android:radius="20dp" />
</shape>
