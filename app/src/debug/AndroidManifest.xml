<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Debug-only broadcast receiver used by the UI-survey harness
        (DELETE_LATER_SURVEY_UI runner). Lets a host script (Python +
        adb shell am broadcast) randomise the dashboard configuration
        and connect a virtual wheel without driving the editor by
        touch events. Exported so the harness can reach it. This
        manifest is only merged into debug builds, never release.
    -->
    <application>
        <receiver
            android:name="com.eried.eucplanet.survey.SurveyControlReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.eried.eucplanet.SURVEY_APPLY" />
                <action android:name="com.eried.eucplanet.SURVEY_CONNECT_VIRTUAL" />
                <action android:name="com.eried.eucplanet.SURVEY_START_NAV" />
                <action android:name="com.eried.eucplanet.SURVEY_CAR_ALARM" />
            </intent-filter>
        </receiver>

        <!--
            Hosts the Android Auto screens on the x86 Android Automotive
            emulator, where Android Auto itself cannot be installed. Same
            EucCarAppService, rendered by the car OS. No launcher entry, so a
            phone's debug build gets no second icon; start it with
            adb shell am start -n com.eried.eucplanet/androidx.car.app.activity.CarAppActivity
        -->
        <activity
            android:name="androidx.car.app.activity.CarAppActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
