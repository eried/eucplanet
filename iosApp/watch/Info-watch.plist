<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>EucPlanetWatch</string>
    <key>CFBundleIdentifier</key>
    <string>com.eried.eucplanet.watch</string>
    <key>CFBundleName</key>
    <string>EucPlanetWatch</string>
    <key>CFBundleDisplayName</key>
    <string>EUC Planet</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>MinimumOSVersion</key>
    <string>10.0</string>
    <!-- Modern single-target watchOS app marker. -->
    <key>WKApplication</key>
    <true/>
    <!-- Standalone for simulator render/testing (no companion installed on the
         paired phone sim). For REAL hardware, drop WKWatchOnly and instead set
         WKCompanionAppBundleIdentifier = com.eried.eucplanet.ios + embed the
         watch app in the iOS bundle so WatchConnectivity pairs the two apps. -->
    <key>WKWatchOnly</key>
    <true/>
    <!-- Platform metadata so `simctl install` accepts the hand-built bundle. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>4</integer>
    </array>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>WatchSimulator</string>
    </array>
    <key>DTPlatformName</key>
    <string>watchsimulator</string>
</dict>
</plist>
