<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>EucPlanet</string>
    <key>CFBundleIdentifier</key>
    <string>com.eried.eucplanet.iosdemo</string>
    <key>CFBundleName</key>
    <string>EucPlanet</string>
    <key>CFBundleDisplayName</key>
    <string>EUC Planet</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>15.0</string>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- Required by Compose Multiplatform (PlistSanityCheck aborts without it). -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <!-- Bluetooth: required before CoreBluetooth scan on a real device (the shared
         BleTransport). Harmless on the Simulator (no radio, never scans). -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>EUC Planet connects to your electric unicycle over Bluetooth to show live ride telemetry.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>EUC Planet connects to your electric unicycle over Bluetooth to show live ride telemetry.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>EUC Planet uses your location for GPS speed, trip tracking, and sunset-based automatic lights.</string>
    <!-- Local Network: iOS 14+ blocks LAN connections (the HUD on your WiFi, e.g.
         192.168.x.x) until this is declared AND the rider grants the permission.
         Loopback (127.0.0.1) is exempt, which is why the HUD link worked in test
         but never reached a real HUD. NSBonjourServices enables mDNS auto-discovery
         of the HUD (_eucplanet._tcp), matching Android's blank-IP fallback. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>EUC Planet streams live ride telemetry to your external HUD over your local Wi-Fi network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_eucplanet._tcp</string>
    </array>
    <!-- Overlay Studio video recording (camera + mic → MP4 burned with the overlay,
         saved to Photos). Camera is unavailable on the Simulator; harmless there. -->
    <key>NSCameraUsageDescription</key>
    <string>EUC Planet records your ride with your custom overlay burned into the video.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>EUC Planet records audio with your ride videos.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>EUC Planet saves your recorded ride videos to your photo library.</string>
    <!-- Platform metadata so `simctl install` accepts the hand-built bundle. -->
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>iPhoneSimulator</string>
    </array>
    <key>DTPlatformName</key>
    <string>iphonesimulator</string>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
    </array>
</dict>
</plist>
