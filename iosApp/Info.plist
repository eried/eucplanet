<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>EucPlanet</string>
    <key>CFBundleIdentifier</key>
    <string>com.eried.eucplanet.iosdemo</string>
    <key>CFBundleName</key>
    <string>EucPlanet</string>
    <key>CFBundleDisplayName</key>
    <string>EUC Planet</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>15.0</string>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- Required by Compose Multiplatform (PlistSanityCheck aborts without it). -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <!-- Bluetooth: required before CoreBluetooth scan on a real device (the shared
         BleTransport). Harmless on the Simulator (no radio, never scans). -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>EUC Planet connects to your electric unicycle over Bluetooth to show live ride telemetry.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>EUC Planet connects to your electric unicycle over Bluetooth to show live ride telemetry.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>EUC Planet uses your location for GPS speed, trip tracking, and sunset-based automatic lights.</string>
    <!-- Platform metadata so `simctl install` accepts the hand-built bundle. -->
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>iPhoneSimulator</string>
    </array>
    <key>DTPlatformName</key>
    <string>iphonesimulator</string>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
    </array>
</dict>
</plist>
