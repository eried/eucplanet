<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>EUC Planet</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!-- Required by Compose Multiplatform (PlistSanityCheck aborts without it). -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <!-- Bluetooth: required before the CoreBluetooth scan on a real device. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>EUC Planet connects to your electric unicycle over Bluetooth to show live ride telemetry.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>EUC Planet connects to your electric unicycle over Bluetooth to show live ride telemetry.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>EUC Planet uses your location for GPS speed, trip tracking, and sunset-based automatic lights.</string>
    <!-- Local Network: iOS 14+ blocks LAN connections (the HUD on your WiFi) until
         this is declared and the rider grants the permission; loopback is exempt.
         NSBonjourServices enables mDNS HUD auto-discovery (matches Android). -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>EUC Planet streams live ride telemetry to your external HUD over your local Wi-Fi network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_eucplanet._tcp</string>
    </array>
    <!-- Overlay Studio video recording: camera + mic → MP4 (overlay burned in) → Photos. -->
    <key>NSCameraUsageDescription</key>
    <string>EUC Planet records your ride with your custom overlay burned into the video.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>EUC Planet records audio with your ride videos.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>EUC Planet saves your recorded ride videos to your photo library.</string>
</dict>
</plist>
